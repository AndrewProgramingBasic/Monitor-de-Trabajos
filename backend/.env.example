# Backend Environment Configuration Template
FLASK_ENV=production
PORT=5000

# Database Connection (Option 1: Complete URL)
DATABASE_URL="postgresql://vpti_admin:PASSWORD@127.0.0.1:5433/vpti_tasks_db"

# Database Connection (Option 2: Individual variables)
DB_USER=vpti_admin
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=vpti_tasks_db

# Security & Tokens
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_here

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:soporte@adantechti.com

# Timing & Alert Scheduler
TIMEZONE=America/Caracas
ALERT_PREWARNING_MINUTES=20
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_JOB_MISFIRE_GRACE_TIME=30

# CORS
CORS_ORIGINS=https://taskmanager.adantechti.com
